#!/usr/bin/env bash
# ach: manage the github-achievements-lab repo from anywhere.
set -euo pipefail

REPO_DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
cd "$REPO_DIR"
WF=daily-commit.yml

usage() {
  cat <<'H'
ach: github-achievements-lab helper

  ach status        Workflow state, recent runs, today's commits, merged PR count
  ach run           Trigger the commit workflow now, wait for it, then pull
  ach pr [message]  Make a small change, open a PR and merge it (counts for Pull Shark)
  ach pull          Pull latest main (the bot commits daily)
  ach on | off      Enable / disable the daily workflow
  ach open          Open the repo in the browser
H
}

wait_run() {
  sleep 5
  local id; id=$(gh run list --workflow "$WF" -L1 --json databaseId --jq '.[0].databaseId')
  gh run watch "$id" --exit-status >/dev/null && echo "Run succeeded." || echo "Run failed: gh run view $id --log"
}

case "${1:-help}" in
  status)
    echo "== Workflow"; gh workflow list | grep -i daily || true
    echo; echo "== Last 5 runs"; gh run list --workflow "$WF" -L5
    git fetch -q
    today=$(date -u +%Y-%m-%d)
    echo; echo "== Bot commits today (UTC $today): $(git show origin/main:activity.md | grep -c "^- $today" || true)"
    echo "== Merged PRs: $(gh pr list --state merged -L 1000 --json number --jq length) (Pull Shark tiers: 2, 16, 128, 1024)"
    ;;
  run)
    gh workflow run "$WF" && echo "Triggered, waiting..." && wait_run
    git pull -q --ff-only && git log --oneline -3
    ;;
  pr)
    msg="${2:-Update notes $(date -u '+%Y-%m-%d %H:%M')}"
    branch="pr-$(date +%s)"
    git checkout -q main && git pull -q --ff-only
    git checkout -q -b "$branch"
    echo "- $(date -u '+%Y-%m-%d %H:%M:%S UTC'): $msg" >> notes.md
    git add notes.md && git commit -qm "$msg"
    git push -q -u origin "$branch" 2>/dev/null
    gh pr create --title "$msg" --body "Created with \`ach pr\`." >/dev/null
    gh pr merge "$branch" --merge --delete-branch >/dev/null
    git checkout -q main && git pull -q --ff-only
    echo "Merged: $msg"
    echo "Merged PRs: $(gh pr list --state merged -L 1000 --json number --jq length)"
    ;;
  pull) git pull --ff-only ;;
  on)   gh workflow enable "$WF" && echo "Daily workflow enabled." ;;
  off)  gh workflow disable "$WF" && echo "Daily workflow disabled." ;;
  open) gh repo view --web ;;
  help|-h|--help) usage ;;
  *) echo "Unknown command: $1"; usage; exit 1 ;;
esac
